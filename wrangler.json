{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docent-landing",
  "account_id": "3ee35ee53cdad85883587acd18f866b5",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "docentbase.com/*",
      "zone_name": "docentbase.com"
    },
    {
      "pattern": "www.docentbase.com/*",
      "zone_name": "docentbase.com"
    }
  ]
}
